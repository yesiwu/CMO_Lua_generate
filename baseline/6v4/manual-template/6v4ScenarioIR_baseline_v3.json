    "expectedObservables": [
      "至少一个红方真实contact",
      "至少一个ScenEdit_AttackContact被接受",
      "至少一艘红方舰艇的DBID 2868库存下降",
      "蓝方目标出现毁伤或蓝方防御弹药消耗上升"
